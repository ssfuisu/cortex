<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cortex_bg">

    <!-- Main Terminal Interface -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- One tab for each session (colors are set from the terminal's color scheme, see MainActivity.applyChrome) -->
        <org.cortex.terminal.view.SessionTabsView
            android:id="@+id/sessionTabs"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/cortex_surface_container" />

        <View
            android:id="@+id/tabsDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Terminal Display Surface -->
        <org.cortex.terminal.view.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dock Divider -->
        <View
            android:id="@+id/dockDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Bottom Bar: Virtual Keys Toolbar & Terminal Search Bar with Slide Animation -->
        <FrameLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:background="@color/cortex_surface_container">

            <!-- 2-Row Extra Keys Keyboard Toolbar -->
            <org.cortex.terminal.view.ExtraKeysView
                android:id="@+id/extraKeysView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Terminal Search Bar (slides in from right over/replacing extra keys) -->
            <org.cortex.terminal.view.TerminalSearchBar
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Left drawer: workspace status, sessions, and app actions -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="308dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/drawer_background"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Header: Cortex emblem + title + Desktop / Update / Settings action tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:id="@+id/drawerBrandBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/drawerBrandIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_terminal" />
            </FrameLayout>

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/cortex_text_primary"
                android:textStyle="bold"
                android:textSize="19sp" />

            <!-- The desktop (X11) -->
            <ImageView
                android:id="@+id/btnDrawerDesktop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:padding="10dp"
                android:src="@drawable/ic_desktop"
                android:contentDescription="@string/drawer_desktop"
                android:background="@drawable/icon_circle_bg" />

            <FrameLayout
                android:id="@+id/layoutUpdateBadge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/icon_circle_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnUpdateCheck"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_update"
                    android:contentDescription="@string/check_for_updates" />

                <View
                    android:id="@+id/updateRedDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_red_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnDrawerSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings"
                android:background="@drawable/icon_circle_bg" />
        </LinearLayout>

        <!-- Active Linux distribution and user summary card (opens distro switcher) -->
        <LinearLayout
            android:id="@+id/drawerEnvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/drawerEnvIconBg"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/drawerEnvIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_distro_ubuntu" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drawerEnvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    tools:text="Ubuntu 24.04 LTS" />

                <TextView
                    android:id="@+id/drawerEnvUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:typeface="monospace"
                    android:textSize="11.5sp"
                    tools:text="cortex@localhost" />
            </LinearLayout>

            <ImageView
                android:id="@+id/drawerEnvChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View
            android:id="@+id/drawerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/cortex_outline_variant" />

        <TextView
            android:id="@+id/drawerSessionsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:text="@string/drawer_sessions"
            android:textAllCaps="true"
            android:textColor="@color/cortex_text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <!-- Active Sessions List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- Drawer Bottom Actions: KEYBOARD and NEW SESSION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnDrawerKeyboard"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="@string/drawer_keyboard"
                android:textColor="@color/cortex_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/icon_circle_bg" />

            <TextView
                android:id="@+id/btnDrawerNewSession"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.25"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="@string/drawer_new_session"
                android:textColor="@color/cortex_bg"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/icon_circle_bg" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
