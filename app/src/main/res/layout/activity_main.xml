<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181825">

    <!-- Main Terminal Interface -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Action Bar (Minimal) -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#11111b"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Cortex"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/layoutUpdateBadge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnUpdateCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_update"
                    android:contentDescription="Check for Updates" />

                <View
                    android:id="@+id/updateRedDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/badge_red_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Terminal Display Surface -->
        <org.cortex.terminal.view.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 2-Row Extra Keys Keyboard Toolbar -->
        <org.cortex.terminal.view.ExtraKeysView
            android:id="@+id/extraKeysView"
            android:layout_width="match_parent"
            android:layout_height="76dp" />

    </LinearLayout>

    <!-- Termux-Style Left Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#181825">

        <!-- Top Settings Gear Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btnDrawerSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical|start"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#313244" />

        <!-- Active Sessions List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#313244" />

        <!-- Drawer Bottom Actions: KEYBOARD and NEW SESSION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btnDrawerKeyboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="KEYBOARD"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="#313244" />

            <TextView
                android:id="@+id/btnDrawerNewSession"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="NEW\nSESSION"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
