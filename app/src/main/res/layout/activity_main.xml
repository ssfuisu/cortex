<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cortex_bg">

    <!-- Main Terminal Interface -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Terminal Display Surface -->
        <org.cortex.terminal.view.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dock Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Bottom Bar: Virtual Keys Toolbar & Terminal Search Bar with Slide Animation -->
        <FrameLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@color/cortex_surface_container">

            <!-- 2-Row Extra Keys Keyboard Toolbar -->
            <org.cortex.terminal.view.ExtraKeysView
                android:id="@+id/extraKeysView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Terminal Search Bar (slides in from right over/replacing extra keys) -->
            <org.cortex.terminal.view.TerminalSearchBar
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Material 3 Left Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/drawer_background"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Top Drawer Header Bar: Title, Subtitle, Update Manager, and Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/drawerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cortex Terminal"
                    android:textColor="@color/cortex_text_primary"
                    android:textStyle="bold"
                    android:textSize="17sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutUpdateBadge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/icon_circle_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnUpdateCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_update"
                    android:contentDescription="Check for Updates" />

                <View
                    android:id="@+id/updateRedDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/badge_red_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnDrawerSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings"
                android:background="@drawable/icon_circle_bg" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Active Sessions List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Drawer Bottom Actions: KEYBOARD and NEW SESSION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnDrawerKeyboard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="KEYBOARD"
                android:textColor="@color/cortex_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/pill_button_bg" />

            <TextView
                android:id="@+id/btnDrawerNewSession"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="+ NEW SESSION"
                android:textColor="@color/cortex_key_active_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/key_button_active" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
