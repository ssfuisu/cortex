<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/session_item_inactive_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/downloadStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_preparing"
        android:textColor="@color/cortex_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/downloadProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/cortex_primary"
        android:progressBackgroundTint="@color/cortex_outline" />

    <TextView
        android:id="@+id/downloadPercentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        tools:text="0%"
        android:textColor="@color/cortex_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
