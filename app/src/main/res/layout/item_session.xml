<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sessionItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <View
        android:id="@+id/sessionActiveIndicator"
        android:layout_width="3dp"
        android:layout_height="22dp"
        android:layout_marginEnd="9dp"
        android:visibility="invisible"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/sessionIconContainer"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/sessionIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_terminal" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sessionLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Session 1"
            android:textColor="@color/cortex_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <!-- Shown for sessions that run as real root (root mode) -->
        <TextView
            android:id="@+id/sessionRootBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/root_badge_bg"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/session_root_badge"
            android:textColor="@color/cortex_accent"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSessionClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/cortex_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:contentDescription="@string/close_session" />

</LinearLayout>
