<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_appearance">
        <ListPreference
            app:defaultValue="amoled"
            app:entries="@array/terminal_theme_entries"
            app:entryValues="@array/terminal_theme_values"
            app:key="terminal_theme"
            app:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="11"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:key="terminal_font_size"
            app:title="@string/pref_font_size_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="show_session_tabs"
            app:summary="@string/pref_session_tabs_summary"
            app:title="@string/pref_session_tabs_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_remote">
        <Preference
            app:key="ssh_server"
            app:summary="@string/pref_ssh_summary"
            app:title="@string/pref_ssh_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_desktop">
        <Preference
            app:key="desktop_open"
            app:title="@string/pref_desktop_open_title" />
        <ListPreference
            app:key="desktop_mouse_mode"
            app:defaultValue="touch"
            app:entries="@array/desktop_mouse_entries"
            app:entryValues="@array/desktop_mouse_values"
            app:title="@string/pref_desktop_mouse_title"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="desktop_scale"
            app:defaultValue="65"
            app:entries="@array/desktop_scale_entries"
            app:entryValues="@array/desktop_scale_values"
            app:title="@string/pref_desktop_scale_title"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="desktop_remove"
            app:title="@string/pref_desktop_remove_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_language">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:key="app_language"
            app:title="@string/pref_language_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_support">
        <Preference
            app:key="telegram_contact_pref"
            app:summary="@string/pref_telegram_summary"
            app:title="@string/pref_telegram_title" />
        <Preference
            app:key="bug_report"
            app:summary="@string/pref_bug_report_summary"
            app:title="@string/pref_bug_report_title" />
    </PreferenceCategory>

</PreferenceScreen>
