<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_appearance">
        <ListPreference
            app:defaultValue="jetbrains_mono"
            app:entries="@array/terminal_font_entries"
            app:entryValues="@array/terminal_font_values"
            app:key="terminal_font"
            app:title="@string/pref_font_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="catppuccin"
            app:entries="@array/terminal_theme_entries"
            app:entryValues="@array/terminal_theme_values"
            app:key="terminal_theme"
            app:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="11"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:key="terminal_font_size"
            app:title="@string/pref_font_size_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="keep_screen_on"
            app:summary="@string/pref_keep_screen_on_summary"
            app:title="@string/pref_keep_screen_on_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="secure_screen"
            app:summary="@string/pref_secure_screen_summary"
            app:title="@string/pref_secure_screen_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_language">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:key="app_language"
            app:title="@string/pref_language_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_notifications">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="notify_long_commands"
            app:summary="@string/pref_notify_summary"
            app:title="@string/pref_notify_title" />

        <ListPreference
            app:defaultValue="30"
            app:dependency="notify_long_commands"
            app:entries="@array/long_command_threshold_entries"
            app:entryValues="@array/long_command_threshold_values"
            app:key="long_command_threshold"
            app:title="@string/pref_notify_threshold_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="allow_osc52"
            app:summary="@string/pref_clipboard_summary"
            app:title="@string/pref_clipboard_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_files">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="documents_enabled"
            app:summary="@string/pref_documents_summary"
            app:title="@string/pref_documents_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_root">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="root_mode"
            app:summary="@string/pref_root_mode_summary"
            app:title="@string/pref_root_mode_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_support">
        <Preference
            app:key="telegram_contact_pref"
            app:summary="@string/pref_telegram_summary"
            app:title="@string/pref_telegram_title" />
        <Preference
            app:key="bug_report"
            app:summary="@string/pref_bug_report_summary"
            app:title="@string/pref_bug_report_title" />
    </PreferenceCategory>

</PreferenceScreen>
