<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Display &amp; Font">
        <ListPreference
            app:defaultValue="11"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:key="terminal_font_size"
            app:title="Font Size"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="keep_screen_on"
            app:summary="Prevent the display from turning off while terminal is active"
            app:title="Keep Screen On" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Environment">
        <Preference
            app:key="apt_install_pref"
            app:summary="Debian GNU/Linux Glibc rootfs and APT package manager"
            app:title="APT Package Manager" />

        <Preference
            app:key="cortex_info_pref"
            app:summary="Tap to view rootless Glibc environment details"
            app:title="Runtime Information" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Community &amp; Support">
        <Preference
            app:key="telegram_contact_pref"
            app:summary="Message developer on Telegram: @ratzgn"
            app:title="Telegram Support" />
    </PreferenceCategory>

</PreferenceScreen>
