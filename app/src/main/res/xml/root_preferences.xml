<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Appearance &amp; Font">
        <ListPreference
            app:defaultValue="jetbrains_mono"
            app:entries="@array/terminal_font_entries"
            app:entryValues="@array/terminal_font_values"
            app:key="terminal_font"
            app:title="Terminal Font"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="catppuccin"
            app:entries="@array/terminal_theme_entries"
            app:entryValues="@array/terminal_theme_values"
            app:key="terminal_theme"
            app:title="Color Scheme"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="11"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:key="terminal_font_size"
            app:title="Font Size"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="keep_screen_on"
            app:summary="Prevent the display from turning off while terminal is active"
            app:title="Keep Screen On" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="secure_screen"
            app:summary="Block screenshots and hide app content in recent tasks (FLAG_SECURE)"
            app:title="Secure Screen" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Community &amp; Support">
        <Preference
            app:key="telegram_contact_pref"
            app:summary="Message developer on Telegram: @ratzgn"
            app:title="Telegram Support" />
    </PreferenceCategory>

</PreferenceScreen>
